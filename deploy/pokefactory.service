[Unit]
Description=PokeFactory Go web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pokefactory
Group=pokefactory
WorkingDirectory=/opt/pokefactory/current
Environment=HOST=127.0.0.1
Environment=PORT=4174
Environment=WEB_ROOT=/opt/pokefactory/current/dist
Environment=STORAGE_ROOT=/opt/pokefactory/current/storage
Environment=STATE_DIR=/var/lib/pokefactory
Environment=ALLOW_UPSTREAM_FETCH=true
ExecStart=/opt/pokefactory/current/bin/pokefactory
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pokefactory

[Install]
WantedBy=multi-user.target
