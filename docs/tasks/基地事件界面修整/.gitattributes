# Preserve diagnostic output bytes, including intentional blank final lines.
audit-*.log -text -whitespace
static-a1-*.log -text -whitespace
# Preserve player evidence and replay scripts byte-for-byte.
evidence/** -text -whitespace
run-*.mjs -text -whitespace
.gitattributes -text
runtime.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
player-prep.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
commit-manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
