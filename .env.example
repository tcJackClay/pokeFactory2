# Enable in-app developer tools panel even in non-dev build.
# 1 = enabled, 0 = disabled
VITE_ENABLE_DEVTOOLS="0"

# 浏览器只访问同源 Go 后端。
VITE_POKEAPI_BASE_URL="/api/pokeapi"
VITE_POKEAPI_CSV_BASE_URL="/api/pokedex-csv"
VITE_POKEAPI_SPRITE_BASE_URL="/api/pokeapi-sprites/pokemon"

# Go 服务。
HOST="0.0.0.0"
PORT="3000"
WEB_ROOT="dist"
STORAGE_ROOT="storage"
STATE_DIR="var"

# 允许 Go 服务在本地数据未命中时访问外部服务并持久化。
# 完成全量同步后可设为 false，使生产运行完全不依赖外网。
ALLOW_UPSTREAM_FETCH="true"

# 本地 Vite 开发服务器转发 /api 时使用。
GO_BACKEND_URL="http://127.0.0.1:3001"
